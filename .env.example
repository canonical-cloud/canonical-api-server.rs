# HTTP listener for the internal Kubernetes service.
BIND_ADDRESS=0.0.0.0:8080

# Required in production. The in-memory fallback is for local routing tests only.
DATABASE_URL=postgres://canonical_api_server:replace-me@postgres:5432/canonical

# Distinct least-privilege worker login. Durable analysis and notification jobs
# stay queued when this is absent; the HTTP process never leases them directly.
QUOTE_WORKER_DATABASE_URL=postgres://canonical_quote_worker:replace-me@postgres:5432/canonical

# At least 32 random bytes. Store only in the Kubernetes secret store and share
# only with canonical-web-server.rs.
CANONICAL_INTERNAL_AUTH_TOKEN=replace-with-at-least-32-random-bytes

# Unpadded base64url encoding of exactly 32 random bytes. Used for encrypted
# verified-contact and capability-token envelopes. Rotation requires a reviewed
# key-ring migration; never replace it in place while active quotes exist.
QUOTE_DATA_ENCRYPTION_KEY=replace-with-43-character-base64url-key
QUOTE_LINK_BASE_URL=https://app.canonical.plus/q

# Server-side Google Gemini credential. Never expose it to browser code.
GEMINI_API_KEY=replace-with-google-ai-studio-secret
# Current approved Pro preview; override only after verifying project access.
GEMINI_MODEL=gemini-3.1-pro-preview

# Product notifications use Twilio Messaging. Shared Auth continues to use
# Twilio Verify for OTPs; do not reuse a Verify service SID here.
TWILIO_ACCOUNT_SID=ACreplacewithaccountsid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_MESSAGING_FROM=+14155550100

RUST_LOG=info
