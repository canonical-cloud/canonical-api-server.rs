# HTTP listener for the internal Kubernetes service.
BIND_ADDRESS=0.0.0.0:8080

# Required in production. Use only the non-owner API role. The in-memory
# fallback is for local routing tests and is not restart-safe.
DATABASE_URL=postgres://canonical_cloud__quote__api_rw:replace-through-secret-store@postgres:5432/canonical

# Deployment/migration jobs use this separate DDL identity. The API process
# must never receive this value.
# MIGRATION_DATABASE_URL=postgres://canonical_cloud__quote__migrator:replace-through-secret-store@postgres:5432/canonical

# At least 32 random bytes. Store only in the Kubernetes secret store and share
# only with canonical-web-server.rs.
CANONICAL_INTERNAL_AUTH_TOKEN=replace-with-at-least-32-random-bytes

# Required before exposing api.canonical.plus to direct bearer clients. This is
# protected introspection, independent from the end-user token and from the web
# tier's CANONICAL_INTERNAL_AUTH_TOKEN.
SHARED_AUTH_BASE=https://app.canonical.plus/shared-auth
SHARED_AUTH_INTROSPECT_SECRET=replace-with-at-least-32-random-bytes
SHARED_AUTH_AUDIENCE=canonical-plus-api

# Server-side Google Gemini credential. Never expose it to browser code.
GEMINI_API_KEY=replace-with-google-ai-studio-secret
# Current operator-approved GA model with high thinking enabled by the client.
GEMINI_MODEL=gemini-3.6-flash

# Optional outbound readiness status events. Configure both values together.
# Use an HTTPS URL without credentials, query parameters, or a fragment, and
# keep the HMAC secret only in the platform secret store.
# CANONICAL_WEBHOOK_URL=https://hooks.example.com/canonical/readiness
# CANONICAL_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

RUST_LOG=info
