PORT=8080
DATABASE_URL=postgresql://canonical_api_runtime:replace-me@postgres/canonical
DATABASE_MAX_CONNECTIONS=10
MIGRATION_DATABASE_URL=postgresql://canonical_api_migrator:replace-me@postgres/canonical

SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# At least 32 random bytes. Shared only with canonical-web-server.rs.
CANONICAL_WEB_SERVICE_TOKEN=replace-with-32-or-more-random-bytes

GEMINI_API_KEY=replace-me
# Defaults to the published Gemini 3.1 Pro Preview endpoint; deployments may override it explicitly.
GEMINI_MODEL=gemini-3.1-pro-preview
QUOTE_CONTEXT_KEY=quote_analysis
QUOTE_WORKER_CONCURRENCY=2
QUOTE_WORKER_POLL_MS=1000
QUOTE_WORKER_LEASE_SECONDS=300
QUOTE_WORKER_MAX_ATTEMPTS=3
WEBSOCKET_MAX_CONNECTIONS=1024
RUST_LOG=info
