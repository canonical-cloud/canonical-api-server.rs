namespace Ores.ServerFilesystemRouting;
enum ApiServerKind { api, admin_api }
model ApiRouteFileContract { authored: ["handlers.rs", "route.rs"]; generated: ["rpc.rs", "lambda.rs"]; }
model UrlSegmentGrammar {
  static_segment: "literal-directory-name";
  dynamic_segment: "[name]";
  catch_all_segment: "[...name]";
  optional_catch_all_segment: "[[...name]]";
  parameter_name_charset: "ascii_alnum_underscore_hyphen";
  duplicate_parameter_names: false;
  catch_all_must_be_final: true;
  hidden_route_groups: false;
  one_to_one_url_mapping: true;
}
model ApiGenerationContract {
  orchestrator: "ores-stack";
  rpc_owner: "ores-stack";
  lambda_owner: "ores-stack";
  rpc_source_authority: "handlers.rs";
  lambda_source_authority: "handlers.rs";
  route_projection: "route.rs";
  provider_neutral_lambda: true;
  rpc_generated_marker: "// @generated by ores-stack sync; do not edit";
  lambda_generated_marker: "// @generated by `ores-stack api lambda sync`; DO NOT EDIT.";
}
model ApiServerFilesystemContract {
  schema_version: "ores.server-filesystem-routing.v1";
  server_kind: ApiServerKind;
  route_root: "src/routes";
  files: ApiRouteFileContract;
  url: UrlSegmentGrammar;
  generation: ApiGenerationContract;
}
