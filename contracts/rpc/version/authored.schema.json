{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canonical-cloud:rpc:version:v1",
  "$defs": {
    "VersionResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["result", "traceIds"],
      "properties": {
        "result": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["service", "version"],
          "properties": {
            "service": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "traceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "VersionError": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
